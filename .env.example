# GEMINI_API_KEY: Required for Gemini AI API calls.
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY & SUPABASE_ANON_KEY: Supabase configuration for Taska backend.
# MAPS_API_KEY: Required for Google Maps SDK for Android interactive maps.
# Configure these via the Secrets panel in AI Studio.
GEMINI_API_KEY=MY_GEMINI_API_KEY
SUPABASE_URL=MY_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=MY_SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=MY_SUPABASE_ANON_KEY
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
